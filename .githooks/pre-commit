#!/usr/bin/env bash
# Git pre-commit hook, activated by `git config core.hooksPath .githooks`.
#
# Two gates, in this order:
#   1. The publication gate — no machine-specific identifiers may enter a public commit. Runs first
#      because it is cheap and it is the gate a rewrite can still satisfy before anything builds.
#   2. The build gate — a thin wrapper on purpose: it lives in exactly one file, which also serves
#      as the harness PreToolUse hook. There it reads the tool-call JSON that Claude Code / DSH put
#      on stdin; here git passes no payload at all, and the script reads that as "this is a commit,
#      check it". Keeping one file means the two entry points cannot drift apart.

root="$(git rev-parse --show-toplevel)" || exit 0

scan="$root/local_dev/scripts/scan-publication-leaks.sh"
if [ -f "$scan" ]; then
    bash "$scan" || {
        echo "pre-commit: publication gate failed — nothing was committed." >&2
        exit 1
    }
fi

gate="$root/.claude/hooks/pre-commit-build-check.sh"
[ -x "$gate" ] || exit 0
exec "$gate"
