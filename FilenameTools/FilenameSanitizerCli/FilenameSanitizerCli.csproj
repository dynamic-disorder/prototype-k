<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- Always build against the sibling project. The previous Release-only
	     PackageReference to FilenameSanitizer 1.0.0 failed to restore (NU1101)
	     because that package id is not published, so `-c Release` never built. -->
	<ItemGroup>
		<ProjectReference Include="..\FilenameSanitizer\FilenameSanitizer.csproj" />
	</ItemGroup>
</Project>
