<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core .NET packages -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- CSV and Data -->
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Shared console library, consumed as a package (see the cliutils repository) -->
    <PackageVersion Include="DynamicDisorder.CliUtils" Version="0.1.1" />
    <!-- CLI Enhancements -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />
    <!-- Text-to-Speech -->
    <PackageVersion Include="PiperSharp" Version="1.0.7" />
    <!-- No project references the NAudio metapackage any more, but the version has to stay pinned:
         PiperSharp pulls NAudio 2.2.1 in transitively, and central transitive pinning needs a
         declared version or NAudio.Core resolves back down to 2.2.1 and fails NU1605. -->
    <PackageVersion Include="NAudio" Version="3.1.0" />
    <!-- The one NAudio package the app references. PiperSharp's WAV conversion calls into
         NAudio.Wasapi, but the NAudio metapackage only pulls that assembly in for Windows targets,
         so it is referenced directly; its lib/net9.0 build keeps the app platform-independent. -->
    <PackageVersion Include="NAudio.Wasapi" Version="3.1.0" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>