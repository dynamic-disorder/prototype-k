<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Project-specific properties only. The target framework comes from Directory.Build.props:
         one platform-independent net10.0 build for Windows, Linux and macOS. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="TextToSpeechApp.syntax.txt" />
    <None Remove="TextToSpeechApp.runtime_commands.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TextToSpeechApp.syntax.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TextToSpeechApp.runtime_commands.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\translations.csv" Link="translations.csv" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TranslationTools\TranslationTools.csproj" />
    <ProjectReference Include="..\TextToSpeechCore\TextToSpeechCore.csproj" />
    <PackageReference Include="DynamicDisorder.CliUtils" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Not an audio backend: PiperSharp's own WAV conversion calls into NAudio.Wasapi, and the
         NAudio metapackage only pulls that assembly in for Windows targets. Its lib/net9.0 build is
         platform-neutral, so referencing it directly is what keeps Piper synthesis working on every
         OS. Playback itself goes through an external command-line player (ProcessWavPlayback), so
         no in-process audio API is referenced at all. -->
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>

  <!-- Make internal types visible to the test project -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TextToSpeechApp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
