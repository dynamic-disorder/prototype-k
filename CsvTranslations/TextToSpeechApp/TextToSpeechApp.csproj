<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Directory.Build.TTS.props" />

  <PropertyGroup>
    <!-- Project-specific properties only -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  
  <ItemGroup>
    <None Remove="TextToSpeechApp.syntax.txt" />
    <None Remove="TextToSpeechApp.runtime_commands.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TextToSpeechApp.syntax.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TextToSpeechApp.runtime_commands.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\translations.csv" Link="translations.csv" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TranslationTools\TranslationTools.csproj" />
    <ProjectReference Include="..\TextToSpeechCore\TextToSpeechCore.csproj" />
    <PackageReference Include="DynamicDisorder.CliUtils" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- NAudio is referenced here, not in TextToSpeechCore, because NAudio.WinMM (the WinMM
         WaveOut player used by NaudioWavPlayback) only ships a Windows target framework.
         Keeping it in this Windows-targeted app is what lets TextToSpeechCore stay net10.0. -->
    <PackageReference Include="NAudio" />
  </ItemGroup>

  <!-- Make internal types visible to the test project -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TextToSpeechApp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>