# Ignore build artifacts and IDE folders
**/obj/
**/bin/
*.user
.vs/
node_modules/
*.code-workspace

# Self-contained bundle output from publish-selfcontained.mjs (~20 MB+ per app).
# Without this a `git add -A` after publishing stages the binaries.
/publish/

# Ignore runtime/persistent data
# Ignore all files in the ai_offline/OpenWebUI/open_webui_data directory, except for README.md
ai_offline/OpenWebUI/open_webui_data/*
!ai_offline/OpenWebUI/open_webui_data/README.md
# Ignore all files in the local_user_files directory, except for README.md
local_user_files/*
!local_user_files/README.md

# Ignore specific temporary files
temp_task_progress.txt
launchSettings.json

# Claude Code: ignore the *contents* of every .claude/ directory, then re-include the shared layer.
# `**/.claude/*` rather than `.claude/` is deliberate: git cannot re-include a file whose parent
# directory is excluded, so the directory stays un-ignored and only its contents are ignored. The
# `**/` prefix keeps one rule working for the root, CsvTranslations/ and FilenameTools/. The shared
# and tracked set is settings.json, hooks/, commands/ and rules/ —
# see local_dev/git-ignored-local-files.md.
**/.claude/*
!**/.claude/settings.json
!**/.claude/commands/
!**/.claude/hooks/
!**/.claude/rules/
CLAUDE.local.md
# settings.local.json is the *personal* overlay on the shareable settings.json, which is tracked in
# the sub-projects. Keep this rule even though `**/.claude/*` above already covers it: it is what
# keeps the personal file ignored if that broader rule is ever narrowed.
**/.claude/settings.local.json
**/.claude/agent-memory-local/
# `.agents/skills/` is deliberately NOT ignored: it holds the tracked, tool-neutral skills.
# Claude Code reaches the same files through the local `.claude/skills` symlink, which
# `**/.claude/*` above already covers.
# `.claudeignore` and `.clinerules` are NOT ignored either: both hold shared, tracked repo
# conventions rather than personal state.
__pycache__/
# Python virtualenvs. `.venv/` currently protects itself with the `.gitignore` (`*`) that
# `python -m venv` writes, but that file is not ours to rely on — this keeps the ~22 MB tree out
# of `git add -A` even if it is removed.
.venv/
venv/


# Continue Dev personal/local files
.continue

# Aider personal/local files (config + chat/input history)
# `.clinerules` is deliberately NOT ignored: it holds the shared, tracked project rules.
.aider*

# Piper TTS runtime artifacts (downloaded on first run)
CsvTranslations/TextToSpeechApp/models/
CsvTranslations/TextToSpeechApp/piper/
